# ============================================================
# .gitignore - SQL-job 小卖部管理系统数据库课程项目
# ============================================================

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# 编辑器/IDE配置
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# 日志文件
*.log
*.err
*.out

# 临时文件
*.tmp
*.temp
*.bak
*.backup
*.old

# 数据库相关（不要提交数据库数据文件）
*.sql.bak
data/
*.ibd
*.frm
*.MYD
*.MYI
*.ibdata1
*.err
*.pid

# 环境变量/配置（包含敏感信息）
.env
.env.local
config.ini
my.cnf
my.ini

# 压缩包（下载的安装包等）
*.zip
*.tar.gz
*.rar
*.7z

# Python（如果有Python脚本）
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Node.js（如果有前端）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 文档临时文件
*.docx.tmp
*.doc.tmp
~$*.docx
~$*.doc
~$*.pptx
~$*.xlsx

# 测试输出
test-output/
*.test.sql
test-results/

# ============================================================
# 例外：允许提交特定文件
# ============================================================

# 允许提交项目中的SQL脚本（已经在版本控制中）
# !week*/**/*.sql

# 允许提交文档
# !week*/**/*.md
